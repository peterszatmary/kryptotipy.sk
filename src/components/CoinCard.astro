---
interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;
const isRight = side === 'right';
---

<div class={`flex flex-col items-center justify-center relative w-full p-1 sm:p-3 md:p-4 lg:p-6 ${isRight ? 'order-2' : 'order-1'}`}>
  <!-- Jemný neutrálny spotlight za mincou -->
  <div class="absolute w-64 h-64 sm:w-[460px] sm:h-[460px] md:w-[480px] md:h-[480px] lg:w-[520px] lg:h-[520px] xl:w-[560px] xl:h-[560px] rounded-3xl bg-gradient-to-r from-zinc-200/35 via-zinc-100/20 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <!-- Perspective 3D Obal – zaoblený štvorec (squircle) pre maximálnu čitateľnosť textu -->
  <div class="perspective-1000 mb-1.5 sm:mb-4 md:mb-5 lg:mb-5">
    <div
      id={`${side}-coin-disc`}
      class="coin-disc relative w-42 h-42 min-[380px]:w-48 min-[380px]:h-48 sm:w-60 sm:h-60 md:w-[335px] md:h-[375px] min-[810px]:w-[350px] min-[810px]:h-[390px] lg:w-80 lg:h-80 xl:w-88 xl:h-88 rounded-3xl preserve-3d transition-all duration-700 shadow-xl shadow-zinc-200/70"
    >
      <!-- PREDNÁ STRANA (FRONT) -->
      <div
        id={`${side}-coin-front`}
        class="backface-hidden absolute inset-0 rounded-3xl flex flex-col items-center justify-center p-3 min-[380px]:p-3.5 sm:p-6 md:p-7 lg:p-8 bg-white border-2 border-zinc-200/90 shadow-xs transition-colors duration-300"
      >
        <!-- Logo mince -->
        <img
          id={`${side}-coin-image`}
          src=""
          alt="Minca"
          class="w-12 h-12 min-[380px]:w-14 min-[380px]:h-14 sm:w-20 sm:h-20 md:w-26 md:h-26 lg:w-26 lg:h-26 xl:w-28 xl:h-28 rounded-full bg-zinc-50 border border-zinc-100 p-1 sm:p-1.5 md:p-2 object-contain mb-1 sm:mb-2.5 md:mb-3.5 transition-transform duration-300 group-hover:scale-105 shrink-0"
          loading="eager"
        />

        <!-- Názov & Symbol mince -->
        <h2 id={`${side}-coin-name`} class="text-xs min-[380px]:text-sm sm:text-base md:text-xl lg:text-lg xl:text-xl font-extrabold text-zinc-900 text-center leading-snug truncate max-w-full px-2 shrink-0">
          Načítavam...
        </h2>
        <span id={`${side}-coin-symbol`} class="text-[9px] min-[380px]:text-[10px] sm:text-xs md:text-sm lg:text-sm font-mono font-bold text-zinc-400 uppercase mt-0.5 shrink-0">
          ---
        </span>

        <!-- Známa hodnota (Vľavo) alebo Záhada (Vpravo) -->
        {isRight ? (
          <div class="mt-1.5 min-[380px]:mt-2.5 sm:mt-3.5 md:mt-4 px-2.5 min-[380px]:px-3.5 sm:px-4 md:px-5 py-0.5 min-[380px]:py-1 md:py-1.5 rounded-full bg-zinc-100 border border-zinc-200/80 text-[11px] min-[380px]:text-xs sm:text-sm md:text-base font-mono font-bold text-zinc-600 shrink-0">
            ???
          </div>
        ) : (
          <div class="mt-1 min-[380px]:mt-1.5 sm:mt-3 md:mt-4 text-center shrink-0">
            <div id="left-coin-metric-value" class="text-base min-[380px]:text-lg sm:text-2xl md:text-3xl lg:text-3xl xl:text-4xl font-black font-mono text-zinc-900 tabular-nums tracking-tight whitespace-nowrap">
              ---
            </div>
            <div id="left-coin-metric-label" class="text-[8px] min-[380px]:text-[9px] sm:text-xs md:text-sm uppercase font-semibold text-zinc-500 tracking-wider mt-0.5">
              Trhová hodnota
            </div>
          </div>
        )}
      </div>

      <!-- ZADNÁ STRANA (Right Coin 3D Flip Reveal) -->
      {isRight && (
        <div
          id="right-coin-back"
          class="backface-hidden rotate-y-180 absolute inset-0 rounded-3xl flex flex-col items-center justify-center p-3 min-[380px]:p-3.5 sm:p-6 md:p-7 lg:p-8 bg-white border-2 border-zinc-200/90 shadow-xs transition-colors duration-300"
        >
          <div id="reveal-ring-status" class="w-9 h-9 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full flex items-center justify-center text-base sm:text-xl md:text-2xl lg:text-2xl font-bold mb-0.5 sm:mb-2 bg-zinc-100 text-zinc-700 shrink-0">
            ?
          </div>
          <div id="right-coin-reveal-name" class="text-[10px] min-[380px]:text-xs sm:text-sm md:text-base font-bold text-zinc-600 mb-0.5 shrink-0 truncate max-w-full px-2">
            Názov mince
          </div>
          <div id="right-coin-reveal-value" class="text-base min-[380px]:text-lg sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-black font-mono text-zinc-900 tabular-nums tracking-tight whitespace-nowrap shrink-0">
            ---
          </div>
          <div id="right-coin-reveal-label" class="text-[8px] min-[380px]:text-[9px] sm:text-xs md:text-sm uppercase font-semibold text-zinc-500 tracking-wider mt-0.5 shrink-0">
            Trhová hodnota
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Ovládanie a tipovacie tlačidlá (Zarovnané podľa dlaždice s identickou výškou) -->
  {isRight ? (
    <div class="flex flex-col items-center justify-center w-full max-w-[260px] min-[400px]:max-w-[280px] sm:max-w-[320px] md:max-w-[350px] lg:max-w-[320px] xl:max-w-[352px] min-h-[44px] sm:min-h-[56px] md:min-h-[62px] lg:min-h-[64px]">
      <div class="grid grid-cols-2 gap-2 sm:gap-2.5 md:gap-3 w-full">
        <button
          type="button"
          id="btn-higher"
          class="group relative flex items-center justify-center gap-1 sm:gap-1.5 py-2 min-[400px]:py-2.5 sm:py-3.5 md:py-4 px-2.5 min-[400px]:px-4 sm:px-5 md:px-6 rounded-xl md:rounded-2xl font-bold text-[11px] min-[400px]:text-xs sm:text-sm md:text-base bg-[#2a6a51] hover:bg-[#215642] text-white border border-[#1b4837]/20 shadow-xs active:scale-95 transition-all duration-150 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span>VYŠŠIE</span>
          <span class="text-[10px] sm:text-sm">▲</span>
          <span class="hidden sm:inline text-[10px] sm:text-xs font-mono text-emerald-100/75 ml-0.5">[▲]</span>
        </button>

        <button
          type="button"
          id="btn-lower"
          class="group relative flex items-center justify-center gap-1 sm:gap-1.5 py-2 min-[400px]:py-2.5 sm:py-3.5 md:py-4 px-2.5 min-[400px]:px-4 sm:px-5 md:px-6 rounded-xl md:rounded-2xl font-bold text-[11px] min-[400px]:text-xs sm:text-sm md:text-base bg-[#8c3b42] hover:bg-[#773137] text-white border border-[#63292e]/20 shadow-xs active:scale-95 transition-all duration-150 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span>NIŽŠIE</span>
          <span class="text-[10px] sm:text-sm">▼</span>
          <span class="hidden sm:inline text-[10px] sm:text-xs font-mono text-rose-100/75 ml-0.5">[▼]</span>
        </button>
      </div>
    </div>
  ) : (
    <div class="flex flex-col items-center justify-center w-full max-w-[260px] min-[400px]:max-w-[280px] sm:max-w-[320px] md:max-w-[350px] lg:max-w-[320px] xl:max-w-[352px] min-h-[44px] sm:min-h-[56px] md:min-h-[62px] lg:min-h-[64px]">
      <div class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-sm md:text-base text-zinc-500 font-mono">
        <span>Trhové poradie:</span>
        <span id="left-coin-rank" class="px-2 sm:px-2.5 md:px-3.5 py-0.5 md:py-1 rounded-md md:rounded-lg bg-zinc-100 border border-zinc-200 text-zinc-800 font-bold md:text-base">
          #1
        </span>
      </div>
    </div>
  )}
</div>
