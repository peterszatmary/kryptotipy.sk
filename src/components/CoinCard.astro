---
interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;
const isRight = side === 'right';
---

<div class={`flex flex-col items-center justify-center relative w-full h-full p-2 sm:p-4 lg:p-6 ${isRight ? 'order-2' : 'order-1'}`}>
  <!-- Jemný neutrálny spotlight za mincou -->
  <div class="absolute w-88 h-88 sm:w-[460px] sm:h-[460px] lg:w-[520px] lg:h-[520px] xl:w-[560px] xl:h-[560px] rounded-3xl bg-gradient-to-r from-zinc-200/35 via-zinc-100/20 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <!-- Perspective 3D Obal – zaoblený štvorec (squircle) pre maximálnu čitateľnosť textu -->
  <div class="perspective-1000 mb-3 sm:mb-5">
    <div
      id={`${side}-coin-disc`}
      class="coin-disc relative w-52 h-52 sm:w-72 sm:h-72 lg:w-80 lg:h-80 xl:w-88 xl:h-88 rounded-3xl preserve-3d transition-all duration-700 shadow-xl shadow-zinc-200/70"
    >
      <!-- PREDNÁ STRANA (FRONT) -->
      <div
        id={`${side}-coin-front`}
        class="backface-hidden absolute inset-0 rounded-3xl flex flex-col items-center justify-center p-5 sm:p-7 lg:p-8 bg-white border-2 border-zinc-200/90 shadow-xs transition-colors duration-300"
      >
        <!-- Logo mince -->
        <img
          id={`${side}-coin-image`}
          src=""
          alt="Minca"
          class="w-18 h-18 sm:w-24 sm:h-24 lg:w-26 lg:h-26 xl:w-28 xl:h-28 rounded-full bg-zinc-50 border border-zinc-100 p-1.5 object-contain mb-2 sm:mb-2.5 transition-transform duration-300 group-hover:scale-105"
          loading="eager"
        />

        <!-- Názov & Symbol mince -->
        <h2 id={`${side}-coin-name`} class="text-sm sm:text-base lg:text-lg xl:text-xl font-extrabold text-zinc-900 text-center leading-tight line-clamp-1">
          Načítavam...
        </h2>
        <span id={`${side}-coin-symbol`} class="text-[11px] sm:text-xs lg:text-sm font-mono font-bold text-zinc-400 uppercase mt-0.5">
          ---
        </span>

        <!-- Známa hodnota (Vľavo) alebo Záhada (Vpravo) -->
        {isRight ? (
          <div class="mt-2.5 sm:mt-3.5 px-3.5 py-1 rounded-full bg-zinc-100 border border-zinc-200/80 text-xs sm:text-sm lg:text-base font-mono font-bold text-zinc-600">
            ???
          </div>
        ) : (
          <div class="mt-2 sm:mt-3 text-center">
            <div id="left-coin-metric-value" class="text-xl sm:text-2xl lg:text-3xl xl:text-4xl font-black font-mono text-zinc-900 tabular-nums tracking-tight">
              ---
            </div>
            <div id="left-coin-metric-label" class="text-[10px] sm:text-xs uppercase font-semibold text-zinc-500 tracking-wider">
              Trhová hodnota
            </div>
          </div>
        )}
      </div>

      <!-- ZADNÁ STRANA (Right Coin 3D Flip Reveal) -->
      {isRight && (
        <div
          id="right-coin-back"
          class="backface-hidden rotate-y-180 absolute inset-0 rounded-3xl flex flex-col items-center justify-center p-5 sm:p-7 lg:p-8 bg-white border-2 border-zinc-200/90 shadow-xs transition-colors duration-300"
        >
          <div id="reveal-ring-status" class="w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center text-xl sm:text-2xl font-bold mb-1 sm:mb-2 bg-zinc-100 text-zinc-700">
            ?
          </div>
          <div id="right-coin-reveal-name" class="text-xs sm:text-sm lg:text-base font-bold text-zinc-600 mb-1">
            Názov mince
          </div>
          <div id="right-coin-reveal-value" class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-black font-mono text-zinc-900 tabular-nums tracking-tight">
            ---
          </div>
          <div id="right-coin-reveal-label" class="text-[10px] sm:text-xs uppercase font-semibold text-zinc-500 tracking-wider mt-0.5">
            Trhová hodnota
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- Ovládanie a tipovacie tlačidlá (Zarovnané podľa dlaždice s identickou výškou) -->
  {isRight ? (
    <div class="flex flex-col items-center justify-center w-full max-w-[280px] sm:max-w-[320px] min-h-[56px] sm:min-h-[64px]">
      <div class="grid grid-cols-2 gap-2.5 w-full">
        <button
          type="button"
          id="btn-higher"
          class="group relative flex items-center justify-center gap-1.5 py-3 sm:py-3.5 px-4 sm:px-5 rounded-xl font-bold text-xs sm:text-sm lg:text-base bg-[#2a6a51] hover:bg-[#215642] text-white border border-[#1b4837]/20 shadow-xs active:scale-95 transition-all duration-150 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span>VYŠŠIE</span>
          <span class="text-xs sm:text-sm">▲</span>
          <span class="hidden sm:inline text-[10px] sm:text-xs font-mono text-emerald-100/75 ml-1">[▲]</span>
        </button>

        <button
          type="button"
          id="btn-lower"
          class="group relative flex items-center justify-center gap-1.5 py-3 sm:py-3.5 px-4 sm:px-5 rounded-xl font-bold text-xs sm:text-sm lg:text-base bg-[#8c3b42] hover:bg-[#773137] text-white border border-[#63292e]/20 shadow-xs active:scale-95 transition-all duration-150 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span>NIŽŠIE</span>
          <span class="text-xs sm:text-sm">▼</span>
          <span class="hidden sm:inline text-[10px] sm:text-xs font-mono text-rose-100/75 ml-1">[▼]</span>
        </button>
      </div>
    </div>
  ) : (
    <div class="flex flex-col items-center justify-center w-full max-w-[280px] sm:max-w-[320px] min-h-[56px] sm:min-h-[64px]">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-zinc-500 font-mono">
        <span>Trhové poradie:</span>
        <span id="left-coin-rank" class="px-2.5 py-0.5 rounded-md bg-zinc-100 border border-zinc-200 text-zinc-800 font-bold">
          #1
        </span>
      </div>
    </div>
  )}
</div>
