---
import { Lock, FileText, Plus } from '@lucide/astro';
---

<section id="dane" class="col-span-1 md:col-span-2 lg:col-span-3 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 p-5 sm:p-6 backdrop-blur-sm relative overflow-hidden shadow-xl">
  <!-- Subtle background glow -->
  <div class="absolute -top-24 -right-24 w-80 h-80 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header & Privacy Badge -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-zinc-800/80">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <FileText class="w-4 h-4" />
        </span>
        <h2 class="text-xl font-bold tracking-tight text-white">
          SK vs. CZ Daňový & Časový Test Kalkulátor
        </h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          100% Client-Side
        </span>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400">
        Výpočet 3-ročného časového testu (ČR) a daňovej záťaže (SR). Zistite presný deň, kedy predáte bez dane.
      </p>
    </div>

    <!-- Prominent Privacy Badge -->
    <div class="inline-flex items-center gap-2 bg-emerald-950/40 border border-emerald-500/30 px-3.5 py-2 rounded-xl text-xs text-emerald-300 font-medium shadow-inner self-start sm:self-auto">
      <Lock class="w-4 h-4 text-emerald-400 shrink-0" />
      <span>
        <strong>100% Súkromné</strong> – dáta neopúšťajú prehliadač (iba localStorage)
      </span>
    </div>
  </div>

  <!-- Residency Switcher & Controls Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 p-4 rounded-xl bg-zinc-950/80 border border-zinc-800">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-zinc-300">Zvoliť daňovú rezidenciu:</span>
      <div class="inline-flex rounded-lg bg-zinc-900 p-1 border border-zinc-700/80">
        <button
          type="button"
          id="residency-cz-btn"
          class="px-3 py-1 rounded-md text-xs font-bold transition-all bg-emerald-500 text-zinc-950 shadow-sm"
        >
          🇨🇿 Česká republika (Časový test)
        </button>
        <button
          type="button"
          id="residency-sk-btn"
          class="px-3 py-1 rounded-md text-xs font-medium text-zinc-400 hover:text-white transition-all"
        >
          🇸🇰 Slovenská republika (19% + 15%)
        </button>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="add-sample-lots-btn"
        class="text-xs font-medium text-zinc-400 hover:text-white px-2.5 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 transition cursor-pointer"
      >
        Vložiť ukážkové dáta
      </button>
      <button
        type="button"
        id="clear-all-lots-btn"
        class="text-xs font-medium text-rose-400 hover:text-rose-300 px-2.5 py-1.5 rounded-lg bg-rose-950/30 hover:bg-rose-900/40 border border-rose-800/40 transition cursor-pointer"
      >
        Vymazať všetko
      </button>
    </div>
  </div>

  <!-- Add New Lot Form -->
  <div class="mb-6 p-4 rounded-xl bg-zinc-950/50 border border-zinc-800/80">
    <div class="text-xs font-bold text-zinc-300 uppercase tracking-wider mb-3 flex items-center gap-1.5">
      <Plus class="w-3.5 h-3.5 text-emerald-400" />
      <span>Pridať nákup do portfólia</span>
    </div>

    <form id="add-lot-form" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3">
      <div>
        <label class="block text-[11px] text-zinc-400 mb-1">Minca</label>
        <input
          type="text"
          id="lot-coin-input"
          placeholder="napr. BTC"
          required
          class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs text-white uppercase font-bold focus:outline-none focus:border-emerald-400"
        />
      </div>

      <div>
        <label class="block text-[11px] text-zinc-400 mb-1">Dátum nákupu</label>
        <input
          type="date"
          id="lot-date-input"
          required
          class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-400"
        />
      </div>

      <div>
        <label class="block text-[11px] text-zinc-400 mb-1">Nákupná cena za 1 ks (€)</label>
        <input
          type="number"
          step="any"
          id="lot-buyprice-input"
          placeholder="25000"
          required
          class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-emerald-400"
        />
      </div>

      <div>
        <label class="block text-[11px] text-zinc-400 mb-1">Množstvo (ks)</label>
        <input
          type="number"
          step="any"
          id="lot-amount-input"
          placeholder="0.25"
          required
          class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-emerald-400"
        />
      </div>

      <div>
        <label class="block text-[11px] text-zinc-400 mb-1">Aktuálna predajná cena (€)</label>
        <div class="flex gap-2">
          <input
            type="number"
            step="any"
            id="lot-currprice-input"
            placeholder="80000"
            required
            class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-emerald-400"
          />
          <button
            type="submit"
            class="bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center justify-center shrink-0 cursor-pointer"
          >
            Pridať
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Lots List / Table -->
  <div class="mb-6 overflow-x-auto">
    <div id="lots-container" class="space-y-3 min-w-[700px]">
      <!-- Populated via Client Script -->
    </div>
  </div>

  <!-- Portfolio Summary & Arbitrage Box -->
  <div class="rounded-xl bg-gradient-to-r from-zinc-950 via-zinc-900 to-zinc-950 border border-zinc-800 p-5">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <div class="text-[11px] text-zinc-400 uppercase font-semibold">Celkové nadobúdacie náklady:</div>
        <div class="text-xl font-bold font-mono text-zinc-300 mt-0.5" id="tax-total-cost">0 €</div>
      </div>

      <div>
        <div class="text-[11px] text-zinc-400 uppercase font-semibold">Aktuálna hodnota portfólia:</div>
        <div class="text-xl font-bold font-mono text-white mt-0.5" id="tax-total-value">0 €</div>
      </div>

      <div>
        <div class="text-[11px] text-zinc-400 uppercase font-semibold">Celkový nerealizovaný zisk:</div>
        <div class="text-xl font-black font-mono text-emerald-400 mt-0.5" id="tax-total-profit">+0 €</div>
      </div>

      <div class="rounded-lg bg-zinc-900/90 border border-zinc-700/70 p-3">
        <div class="text-[11px] text-zinc-400 uppercase font-bold" id="tax-due-header">Odhadovaná daň (ČR):</div>
        <div class="text-xl font-black font-mono text-emerald-400 mt-0.5" id="tax-total-due">0 €</div>
        <div class="text-[10px] text-zinc-400 mt-1" id="tax-due-subtext">
          V ČR po 3 rokoch držania je daň 0 %.
        </div>
      </div>
    </div>

    <!-- SK vs CZ Arbitrage Highlight Banner -->
    <div id="arbitrage-banner" class="mt-4 pt-4 border-t border-zinc-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
      <div class="text-zinc-300">
        💡 <strong>Daňové porovnanie SR vs ČR:</strong>
        Na Slovensku by ste zo zisku zaplatili 19 % daň + 15 % zdravotné odvody (<span id="arb-sk-tax" class="font-mono text-rose-400 font-bold">0 €</span>).
        V Českej republike po 3 rokoch držania zaplatíte <strong>0 €</strong>.
      </div>
      <div class="shrink-0 bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-3 py-1.5 rounded-lg font-mono font-bold">
        Ušetrené na dani: <span id="arb-savings">0 €</span>
      </div>
    </div>
  </div>
</section>

<!-- Client Script for Tax Calculator Island -->
<script>
  interface Lot {
    id: string;
    coin: string;
    buyDate: string;
    buyPrice: number;
    amount: number;
    currentPrice: number;
  }

  const STORAGE_KEY = 'kryptotipy_tax_portfolio_v1';

  const sampleLots: Lot[] = [
    {
      id: 'sample-1',
      coin: 'BTC',
      buyDate: '2022-11-20',
      buyPrice: 16500,
      amount: 0.5,
      currentPrice: 80000,
    },
    {
      id: 'sample-2',
      coin: 'SOL',
      buyDate: '2024-08-05',
      buyPrice: 130,
      amount: 15,
      currentPrice: 180,
    },
    {
      id: 'sample-3',
      coin: 'ETH',
      buyDate: '2025-02-10',
      buyPrice: 2800,
      amount: 2.0,
      currentPrice: 3200,
    }
  ];

  let currentResidency: 'CZ' | 'SR' = 'CZ';
  let lots: Lot[] = [];

  function loadLots(): Lot[] {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      if (data) return JSON.parse(data);
    } catch {}
    return sampleLots;
  }

  function saveLots() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(lots));
    } catch {}
  }

  function calculateLotMetrics(lot: Lot) {
    const costBasis = lot.buyPrice * lot.amount;
    const currentValue = lot.currentPrice * lot.amount;
    const profitEur = currentValue - costBasis;

    const buy = new Date(lot.buyDate);
    const now = new Date();
    const diffTime = Math.max(0, now.getTime() - buy.getTime());
    const daysHeld = Math.floor(diffTime / (1000 * 60 * 60 * 24));

    // CZ 3-Year Time Test = 1095 days
    const isCzTimeTestMet = daysHeld >= 1095;
    const daysRemaining = Math.max(0, 1095 - daysHeld);
    const exemptionDateObj = new Date(buy.getTime() + 1095 * 24 * 60 * 60 * 1000);
    const exemptionDateStr = exemptionDateObj.toLocaleDateString('sk-SK');

    // Taxes
    const czTax = isCzTimeTestMet ? 0 : Math.max(0, profitEur * 0.15);
    const skTax = Math.max(0, profitEur * 0.19);
    const skHealth = Math.max(0, profitEur * 0.15);
    const skTotalTax = skTax + skHealth;

    return {
      costBasis,
      currentValue,
      profitEur,
      daysHeld,
      isCzTimeTestMet,
      daysRemaining,
      exemptionDateStr,
      czTax,
      skTotalTax,
    };
  }

  function renderLots() {
    const container = document.getElementById('lots-container');
    if (!container) return;

    if (lots.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-zinc-500 rounded-xl bg-zinc-950/40 border border-zinc-800">
          Zatiaľ nemáte pridané žiadne nákupy. Kliknite na <strong>„Vložiť ukážkové dáta“</strong> alebo vyplňte formulár vyššie.
        </div>
      `;
      updateSummary();
      return;
    }

    container.innerHTML = lots.map((lot) => {
      const m = calculateLotMetrics(lot);
      const isCz = currentResidency === 'CZ';

      let statusBadge = '';
      if (isCz) {
        if (m.isCzTimeTestMet) {
          statusBadge = `
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              ✓ Oslobodené od dane (3-ročný test splnený - 0% daň)
            </span>
          `;
        } else {
          statusBadge = `
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
              ⏳ Chýba ešte ${m.daysRemaining} dní do 0% dane (Dátum: ${m.exemptionDateStr})
            </span>
          `;
        }
      } else {
        // SR
        statusBadge = `
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/30">
            🇸🇰 Sadzba SR: 19% daň + 15% odvody (~34% zo zisku)
          </span>
        `;
      }

      return `
        <div class="p-4 rounded-xl bg-zinc-950/60 border border-zinc-800/80 hover:border-zinc-700 transition flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1.5">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-0.5 rounded-lg bg-zinc-800 text-white font-black font-mono text-sm border border-zinc-700">
                ${lot.coin}
              </span>
              <span class="text-xs text-zinc-400 font-mono">
                Nákup: ${new Date(lot.buyDate).toLocaleDateString('sk-SK')} (${m.daysHeld} dní dozadu)
              </span>
              ${statusBadge}
            </div>

            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-zinc-400 font-mono">
              <span>Množstvo: <strong class="text-zinc-200">${lot.amount}</strong></span>
              <span>Nákupná cena: <strong class="text-zinc-200">${lot.buyPrice.toLocaleString('sk-SK')} €</strong></span>
              <span>Aktuálna: <strong class="text-zinc-200">${lot.currentPrice.toLocaleString('sk-SK')} €</strong></span>
              <span>Náklad: <strong class="text-zinc-300">${Math.round(m.costBasis).toLocaleString('sk-SK')} €</strong></span>
              <span>Hodnota: <strong class="text-zinc-100">${Math.round(m.currentValue).toLocaleString('sk-SK')} €</strong></span>
            </div>
          </div>

          <div class="flex items-center justify-between md:justify-end gap-4 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-zinc-800">
            <div class="text-right">
              <div class="text-[10px] text-zinc-500 uppercase font-semibold">Zisk / Daň:</div>
              <div class="text-sm font-black font-mono ${m.profitEur >= 0 ? 'text-emerald-400' : 'text-rose-400'}">
                ${m.profitEur >= 0 ? '+' : ''}${Math.round(m.profitEur).toLocaleString('sk-SK')} €
              </div>
              <div class="text-[11px] font-mono text-zinc-400">
                Daň: <strong class="${isCz && m.isCzTimeTestMet ? 'text-emerald-400' : 'text-zinc-300'}">
                  ${Math.round(isCz ? m.czTax : m.skTotalTax).toLocaleString('sk-SK')} €
                </strong>
              </div>
            </div>

            <button
              type="button"
              class="delete-lot-btn p-2 rounded-lg bg-zinc-900 hover:bg-rose-950/40 text-zinc-500 hover:text-rose-400 border border-zinc-800 transition cursor-pointer"
              data-id="${lot.id}"
              title="Zmazať tento záznam"
            >
              ✕
            </button>
          </div>
        </div>
      `;
    }).join('');

    // Attach delete listeners
    document.querySelectorAll('.delete-lot-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        lots = lots.filter((l) => l.id !== id);
        saveLots();
        renderLots();
      });
    });

    updateSummary();
  }

  function updateSummary() {
    let totalCost = 0;
    let totalValue = 0;
    let totalProfit = 0;
    let totalCzTax = 0;
    let totalSkTax = 0;

    for (const lot of lots) {
      const m = calculateLotMetrics(lot);
      totalCost += m.costBasis;
      totalValue += m.currentValue;
      totalProfit += m.profitEur;
      totalCzTax += m.czTax;
      totalSkTax += m.skTotalTax;
    }

    const costEl = document.getElementById('tax-total-cost');
    const valueEl = document.getElementById('tax-total-value');
    const profitEl = document.getElementById('tax-total-profit');
    const dueHeaderEl = document.getElementById('tax-due-header');
    const dueEl = document.getElementById('tax-total-due');
    const dueSubtextEl = document.getElementById('tax-due-subtext');
    const arbSkTaxEl = document.getElementById('arb-sk-tax');
    const arbSavingsEl = document.getElementById('arb-savings');

    if (costEl) costEl.innerText = `${Math.round(totalCost).toLocaleString('sk-SK')} €`;
    if (valueEl) valueEl.innerText = `${Math.round(totalValue).toLocaleString('sk-SK')} €`;
    if (profitEl) {
      profitEl.innerText = `${totalProfit >= 0 ? '+' : ''}${Math.round(totalProfit).toLocaleString('sk-SK')} €`;
      profitEl.className = `text-xl font-black font-mono mt-0.5 ${totalProfit >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
    }

    const isCz = currentResidency === 'CZ';
    if (dueHeaderEl) dueHeaderEl.innerText = isCz ? 'Odhadovaná daň (ČR):' : 'Odhadovaná daň a odvody (SR):';

    const dueAmount = isCz ? totalCzTax : totalSkTax;
    if (dueEl) {
      dueEl.innerText = `${Math.round(dueAmount).toLocaleString('sk-SK')} €`;
      dueEl.className = `text-xl font-black font-mono mt-0.5 ${dueAmount === 0 ? 'text-emerald-400' : 'text-rose-400'}`;
    }

    if (dueSubtextEl) {
      if (isCz) {
        dueSubtextEl.innerText = 'V ČR po 3 rokoch držania je daň 0 % (alebo do 100k CZK ročne).';
      } else {
        dueSubtextEl.innerText = 'SR nemá časový test pre krypto. Zisk podlieha 19% dani + 15% zdravotným odvodom.';
      }
    }

    if (arbSkTaxEl) arbSkTaxEl.innerText = `${Math.round(totalSkTax).toLocaleString('sk-SK')} €`;

    const savings = Math.max(0, totalSkTax - totalCzTax);
    if (arbSavingsEl) arbSavingsEl.innerText = `${Math.round(savings).toLocaleString('sk-SK')} €`;
  }

  function initTaxCalculator() {
    lots = loadLots();

    // Residency toggle buttons
    const czBtn = document.getElementById('residency-cz-btn');
    const skBtn = document.getElementById('residency-sk-btn');

    czBtn?.addEventListener('click', () => {
      currentResidency = 'CZ';
      czBtn.className = 'px-3 py-1 rounded-md text-xs font-bold transition-all bg-emerald-500 text-zinc-950 shadow-sm';
      if (skBtn) skBtn.className = 'px-3 py-1 rounded-md text-xs font-medium text-zinc-400 hover:text-white transition-all';
      renderLots();
    });

    skBtn?.addEventListener('click', () => {
      currentResidency = 'SR';
      skBtn.className = 'px-3 py-1 rounded-md text-xs font-bold transition-all bg-emerald-500 text-zinc-950 shadow-sm';
      if (czBtn) czBtn.className = 'px-3 py-1 rounded-md text-xs font-medium text-zinc-400 hover:text-white transition-all';
      renderLots();
    });

    // Sample data button
    document.getElementById('add-sample-lots-btn')?.addEventListener('click', () => {
      lots = [...sampleLots];
      saveLots();
      renderLots();
    });

    // Clear all button
    document.getElementById('clear-all-lots-btn')?.addEventListener('click', () => {
      if (confirm('Naozaj chcete vymazať všetky záznamy z vášho prehliadača?')) {
        lots = [];
        saveLots();
        renderLots();
      }
    });

    // Add lot form
    const form = document.getElementById('add-lot-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const coin = (document.getElementById('lot-coin-input') as HTMLInputElement).value.trim().toUpperCase();
      const buyDate = (document.getElementById('lot-date-input') as HTMLInputElement).value;
      const buyPrice = parseFloat((document.getElementById('lot-buyprice-input') as HTMLInputElement).value);
      const amount = parseFloat((document.getElementById('lot-amount-input') as HTMLInputElement).value);
      const currentPrice = parseFloat((document.getElementById('lot-currprice-input') as HTMLInputElement).value);

      if (!coin || !buyDate || isNaN(buyPrice) || isNaN(amount) || isNaN(currentPrice)) return;

      const newLot: Lot = {
        id: `lot-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`,
        coin,
        buyDate,
        buyPrice,
        amount,
        currentPrice,
      };

      lots.unshift(newLot);
      saveLots();
      renderLots();
      form.reset();
    });

    renderLots();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTaxCalculator);
  } else {
    initTaxCalculator();
  }
</script>
