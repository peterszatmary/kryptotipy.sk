---
import { getPolymarketEvents } from '../lib/polymarket';
import { Target, ExternalLink } from '@lucide/astro';

const events = await getPolymarketEvents();
---

<section id="polymarket" class="col-span-1 md:col-span-2 lg:col-span-3 rounded-2xl bg-white border border-zinc-200/80 p-5 sm:p-6 relative overflow-hidden shadow-sm">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-zinc-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-blue-50 text-blue-600 border border-blue-200">
          <Target class="w-4 h-4" />
        </span>
        <h2 class="text-xl font-bold tracking-tight text-zinc-900">
          Polymarket & Smart Money Radar
        </h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
          Zero-JS SSG
        </span>
      </div>
      <p class="text-xs sm:text-sm text-zinc-500">
        Kam vsádzajú skutočné peniaze globálni krypto investori. Predikčné trhy s reálnou likviditou bez emócií.
      </p>
    </div>

    <div class="text-xs text-zinc-600 font-mono self-start sm:self-auto flex items-center gap-1.5 bg-zinc-50 px-3 py-1.5 rounded-lg border border-zinc-200">
      <span class="w-2 h-2 rounded-full bg-blue-500"></span>
      <span>Aktualizované pri každom SSG builde</span>
    </div>
  </div>

  <!-- Table / Cards List of Prediction Markets -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {events.slice(0, 6).map((item) => {
      const isHighProb = item.yesProbability >= 60;
      const isLowProb = item.yesProbability <= 40;
      const probColor = isHighProb ? 'text-emerald-600' : isLowProb ? 'text-zinc-500' : 'text-blue-600';
      const barColor = isHighProb ? 'bg-emerald-500' : isLowProb ? 'bg-zinc-400' : 'bg-blue-500';

      return (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl bg-zinc-50/60 hover:bg-zinc-50 border border-zinc-200/80 hover:border-zinc-300 p-4 transition duration-200 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs text-zinc-500 mb-2">
              <span class="px-2 py-0.5 rounded bg-zinc-200/70 text-zinc-700 font-semibold text-[11px] border border-zinc-300/40">
                {item.category}
              </span>
              <span class="text-zinc-400 group-hover:text-blue-600 transition-colors inline-flex items-center gap-1 text-[11px]">
                Polymarket <ExternalLink class="w-3 h-3" />
              </span>
            </div>

            <h3 class="text-sm font-semibold text-zinc-800 group-hover:text-zinc-950 line-clamp-2 leading-snug">
              {item.question}
            </h3>
          </div>

          <div class="mt-4 pt-3 border-t border-zinc-200/60">
            <div class="flex items-baseline justify-between mb-1.5">
              <span class="text-xs text-zinc-500">Pravdepodobnosť „ÁNO“:</span>
              <span class={`text-xl font-black font-mono ${probColor}`}>
                {item.yesProbability} %
              </span>
            </div>

            <!-- Probability Bar -->
            <div class="h-2 w-full bg-zinc-200 rounded-full overflow-hidden flex">
              <div
                class={`h-full ${barColor} transition-all duration-500`}
                style={`width: ${item.yesProbability}%`}
              ></div>
            </div>

            <div class="flex items-center justify-between mt-2.5 text-[11px] font-mono text-zinc-500">
              <span>Objem stávok:</span>
              <span class="text-zinc-900 font-semibold">
                ${(item.volumeUsd / 1_000_000).toFixed(1)}M USD
              </span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>
