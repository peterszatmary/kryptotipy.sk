---
import { getPolymarketEvents } from '../lib/polymarket';
import { Target, ExternalLink } from '@lucide/astro';

const events = await getPolymarketEvents();
---

<section id="polymarket" class="col-span-1 md:col-span-2 lg:col-span-3 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 p-5 sm:p-6 backdrop-blur-sm relative overflow-hidden shadow-xl">
  <!-- Subtle background glow -->
  <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-zinc-800/80">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20">
          <Target class="w-4 h-4" />
        </span>
        <h2 class="text-xl font-bold tracking-tight text-white">
          Polymarket & Smart Money Radar
        </h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          Zero-JS SSG
        </span>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400">
        Kam vsádzajú skutočné peniaze globálni krypto investori. Predikčné trhy s reálnou likviditou bez emócií.
      </p>
    </div>

    <div class="text-xs text-zinc-400 font-mono self-start sm:self-auto flex items-center gap-1.5 bg-zinc-950/60 px-3 py-1.5 rounded-lg border border-zinc-800">
      <span class="w-2 h-2 rounded-full bg-blue-400"></span>
      <span>Aktualizované pri každom SSG builde</span>
    </div>
  </div>

  <!-- Table / Cards List of Prediction Markets -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {events.slice(0, 6).map((item) => {
      const isHighProb = item.yesProbability >= 60;
      const isLowProb = item.yesProbability <= 40;
      const probColor = isHighProb ? 'text-emerald-400' : isLowProb ? 'text-zinc-400' : 'text-blue-400';
      const barColor = isHighProb ? 'bg-emerald-500' : isLowProb ? 'bg-zinc-500' : 'bg-blue-500';

      return (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl bg-zinc-950/50 hover:bg-zinc-950/80 border border-zinc-800/80 hover:border-zinc-700/80 p-4 transition-all duration-200 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
              <span class="px-2 py-0.5 rounded bg-zinc-800/90 text-zinc-300 font-medium text-[11px] border border-zinc-700/40">
                {item.category}
              </span>
              <span class="text-zinc-400 group-hover:text-blue-400 transition-colors inline-flex items-center gap-1 text-[11px]">
                Polymarket <ExternalLink class="w-3 h-3" />
              </span>
            </div>

            <h3 class="text-sm font-semibold text-zinc-100 group-hover:text-white line-clamp-2 leading-snug">
              {item.question}
            </h3>
          </div>

          <div class="mt-4 pt-3 border-t border-zinc-800/60">
            <div class="flex items-baseline justify-between mb-1.5">
              <span class="text-xs text-zinc-400">Pravdepodobnosť „ÁNO“:</span>
              <span class={`text-xl font-black font-mono ${probColor}`}>
                {item.yesProbability} %
              </span>
            </div>

            <!-- Probability Bar -->
            <div class="h-2 w-full bg-zinc-800 rounded-full overflow-hidden flex">
              <div
                class={`h-full ${barColor} transition-all duration-500`}
                style={`width: ${item.yesProbability}%`}
              ></div>
            </div>

            <div class="flex items-center justify-between mt-2.5 text-[11px] font-mono text-zinc-400">
              <span>Objem stávok:</span>
              <span class="text-zinc-200 font-semibold">
                ${(item.volumeUsd / 1_000_000).toFixed(1)}M USD
              </span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>
