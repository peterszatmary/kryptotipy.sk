---
import { getLocalRssHeadlines } from '../lib/rss';
import { Newspaper, ExternalLink } from '@lucide/astro';

const articles = await getLocalRssHeadlines();
---

<section id="spravy" class="col-span-1 md:col-span-2 lg:col-span-3 rounded-2xl bg-white border border-zinc-200/80 p-5 sm:p-6 relative overflow-hidden shadow-sm">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-zinc-100">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-zinc-100 text-zinc-700 border border-zinc-200">
          <Newspaper class="w-4 h-4" />
        </span>
        <h2 class="text-xl font-bold tracking-tight text-zinc-900">
          Lokálny SK/CZ Krypto Prehľad
        </h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
          Multi-Source SSG Feed
        </span>
      </div>
      <p class="text-xs sm:text-sm text-zinc-500">
        Výber najnovších správ z overených zdrojov: KryptoNovinky.sk, Kryptomagazín, Bitcoin v Kapse. Žiadne reklamy ani clickbaity.
      </p>
    </div>

    <!-- Active Feeds Badge -->
    <div class="text-xs text-zinc-600 font-mono self-start sm:self-auto flex items-center gap-2 bg-zinc-50 px-3 py-1.5 rounded-lg border border-zinc-200">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>KryptoNovinky • Kryptomagazín • Bitcoin v Kapse</span>
    </div>
  </div>

  <!-- Articles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
    {articles.map((item) => (
      <a
        href={item.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-xl bg-zinc-50/70 hover:bg-zinc-50 border border-zinc-200/80 hover:border-zinc-300 transition flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between text-xs text-zinc-500 mb-2">
            <span class="px-2 py-0.5 rounded bg-zinc-200/70 text-zinc-700 font-semibold text-[11px] border border-zinc-300/40">
              {item.source}
            </span>
            <span class="text-[11px] font-mono text-zinc-500">{item.pubDate}</span>
          </div>

          <h3 class="text-sm font-semibold text-zinc-800 group-hover:text-amber-600 transition-colors leading-snug">
            {item.title}
          </h3>
        </div>

        <div class="mt-3 pt-2.5 border-t border-zinc-200/60 flex items-center justify-between text-xs text-zinc-500 group-hover:text-zinc-700 transition-colors">
          <span class="text-[11px] font-mono text-zinc-500">Kategória: {item.category || 'Krypto'}</span>
          <span class="inline-flex items-center gap-1 text-[11px] text-zinc-600 group-hover:text-amber-600 font-medium">
            Čítať článok <ExternalLink class="w-3 h-3" />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
