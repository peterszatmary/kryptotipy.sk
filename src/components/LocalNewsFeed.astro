---
import { getLocalRssHeadlines } from '../lib/rss';
import { Newspaper, ExternalLink } from '@lucide/astro';

const articles = await getLocalRssHeadlines();
---

<section id="spravy" class="col-span-1 md:col-span-2 lg:col-span-3 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 p-5 sm:p-6 backdrop-blur-sm relative overflow-hidden shadow-xl">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-zinc-800/80">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-flex items-center justify-center p-1.5 rounded-lg bg-zinc-800 text-zinc-300 border border-zinc-700/60">
          <Newspaper class="w-4 h-4" />
        </span>
        <h2 class="text-xl font-bold tracking-tight text-white">
          Lokálny SK/CZ Krypto Prehľad
        </h2>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          Ad-Free SSG Feed
        </span>
      </div>
      <p class="text-xs sm:text-sm text-zinc-400">
        Výber najnovších správ z overených slovenských a českých zdrojov. Žiadne bannery, trackery ani clickbait reklamy.
      </p>
    </div>

    <div class="text-xs text-zinc-400 font-mono self-start sm:self-auto flex items-center gap-2 bg-zinc-950/60 px-3 py-1.5 rounded-lg border border-zinc-800">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Kryptomagazin.sk & Bitcoin v Kapse</span>
    </div>
  </div>

  <!-- Articles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
    {articles.map((item) => (
      <a
        href={item.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group p-4 rounded-xl bg-zinc-950/40 hover:bg-zinc-950/80 border border-zinc-800/70 hover:border-zinc-700 transition flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
            <span class="px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 font-medium text-[11px] border border-zinc-700/40">
              {item.source}
            </span>
            <span class="text-[11px] font-mono text-zinc-400">{item.pubDate}</span>
          </div>

          <h3 class="text-sm font-semibold text-zinc-200 group-hover:text-amber-400 transition-colors leading-snug">
            {item.title}
          </h3>
        </div>

        <div class="mt-3 pt-2.5 border-t border-zinc-800/60 flex items-center justify-between text-xs text-zinc-400 group-hover:text-zinc-300 transition-colors">
          <span class="text-[11px] font-mono text-zinc-400">Kategória: {item.category || 'Krypto'}</span>
          <span class="inline-flex items-center gap-1 text-[11px] text-zinc-400 group-hover:text-amber-400">
            Čítať článok <ExternalLink class="w-3 h-3" />
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
