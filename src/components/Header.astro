---
import GithubIcon from './GithubIcon.astro';
---

<header class="border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 via-orange-500 to-emerald-400 p-[1px] shadow-lg shadow-amber-500/10">
        <div class="w-full h-full bg-zinc-950 rounded-[11px] flex items-center justify-center font-black text-amber-400 text-lg group-hover:scale-105 transition-transform">
          ₿
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-extrabold text-lg tracking-tight text-white group-hover:text-amber-400 transition-colors">
            kryptotipy<span class="text-amber-400">.sk</span>
          </span>
          <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700/60">
            Jamstack SSG
          </span>
        </div>
        <p class="text-[11px] text-zinc-400 font-medium hidden sm:block">
          Algoritmické skratky pre racionálne krypto rozhodnutia
        </p>
      </div>
    </a>

    <!-- Right Controls & Status -->
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Live Status Pill -->
      <div class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs text-zinc-300">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="font-mono text-[11px] hidden xs:inline text-zinc-400">Live API + Hourly SSG</span>
      </div>

      <!-- Quick Nav -->
      <nav class="hidden md:flex items-center gap-4 text-xs font-medium text-zinc-400">
        <a href="#semafor" class="hover:text-white transition-colors">Semafor</a>
        <a href="#polymarket" class="hover:text-white transition-colors">Polymarket</a>
        <a href="#zlavomat" class="hover:text-white transition-colors">Zľavomat & DCA</a>
        <a href="#stroj-casu" class="hover:text-white transition-colors">Stroj Času</a>
        <a href="#dane" class="hover:text-white transition-colors">Daňový Test</a>
      </nav>

      <!-- GitHub Link -->
      <a
        href="https://github.com/peterszatmary/kryptotipy.sk"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white border border-zinc-800 transition-colors"
        title="Zdrojový kód na GitHub"
      >
        <GithubIcon class="w-4 h-4" />
      </a>
    </div>
  </div>
</header>
