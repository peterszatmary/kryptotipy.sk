---
import GameIcon from './GameIcon.astro';
---

<div id="arena-mystery-stats" class="game-arena hidden flex-1 w-full max-w-2xl mx-auto flex-col items-center justify-center px-2 sm:px-4 py-1 sm:py-2 relative min-h-0">
  <div class="text-center mb-1.5 sm:mb-3 shrink-0">
    <span class="inline-flex items-center gap-1.5 text-[9px] sm:text-xs font-mono font-bold uppercase tracking-wider px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full bg-zinc-100 border border-zinc-200 text-zinc-700 shadow-2xs">
      <GameIcon name="mystery_stats" class="w-3.5 h-3.5 text-[#2a6a51]" />
      <span>Krypto Detektív</span>
    </span>
    <h2 class="text-sm sm:text-xl lg:text-2xl font-black text-zinc-900 tracking-tight mt-0.5 sm:mt-1">
      Uhádni kryptomenu podľa štatistík
    </h2>
    <p class="text-[11px] sm:text-xs text-zinc-500 mt-0.5 hidden min-[400px]:block">
      Analyzuj reálne trhové dáta a vyber správnu kryptomenu zo 4 možností.
    </p>
  </div>

  <!-- Karta záhady (Dossier) -->
  <div
    id="detective-dossier"
    class="w-full rounded-2xl bg-white border-2 border-zinc-200/90 p-3 sm:p-6 shadow-sm mb-2.5 sm:mb-4 relative transition-colors duration-300"
  >
    <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-3">
      <div class="flex items-center gap-3">
        <div id="detective-icon-container" class="w-12 h-12 rounded-xl bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-600 overflow-hidden shrink-0">
          <svg id="detective-mystery-icon" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
            <circle cx="11" cy="11" r="3" stroke-width="1.8" />
          </svg>
          <img id="detective-reveal-img" src="" alt="Minca" class="hidden w-full h-full object-contain p-1" />
        </div>
        <div>
          <div id="detective-target-name" class="text-sm sm:text-base font-extrabold text-zinc-900">
            Neznáma kryptomena #???
          </div>
          <div id="detective-target-symbol" class="text-xs font-mono text-zinc-400 font-bold">
            Dáta priamo z TOP 100
          </div>
        </div>
      </div>

      <div class="text-right">
        <span class="text-[10px] text-zinc-400 uppercase font-semibold">Trhové poradie</span>
        <div id="detective-rank" class="text-base sm:text-lg font-black font-mono text-zinc-900">
          #--
        </div>
      </div>
    </div>

    <!-- Mriežka štatistík -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3 text-center">
      <div class="p-2 sm:p-2.5 rounded-xl bg-zinc-50 border border-zinc-100">
        <div class="text-[10px] uppercase font-semibold text-zinc-400">Aktuálna cena</div>
        <div id="detective-price" class="text-xs sm:text-sm font-black font-mono text-zinc-900 mt-0.5 tabular-nums">
          ---
        </div>
      </div>

      <div class="p-2 sm:p-2.5 rounded-xl bg-zinc-50 border border-zinc-100">
        <div class="text-[10px] uppercase font-semibold text-zinc-400">24h zmena</div>
        <div id="detective-change" class="text-xs sm:text-sm font-black font-mono text-zinc-900 mt-0.5 tabular-nums">
          ---
        </div>
      </div>

      <div class="p-2 sm:p-2.5 rounded-xl bg-zinc-50 border border-zinc-100">
        <div class="text-[10px] uppercase font-semibold text-zinc-400">Prepad od ATH</div>
        <div id="detective-ath" class="text-xs sm:text-sm font-black font-mono text-zinc-900 mt-0.5 tabular-nums">
          ---
        </div>
      </div>

      <div class="p-2 sm:p-2.5 rounded-xl bg-zinc-50 border border-zinc-100 col-span-2 sm:col-span-3">
        <div class="text-[10px] uppercase font-semibold text-zinc-400">24h objem obchodov</div>
        <div id="detective-volume" class="text-xs sm:text-sm font-black font-mono text-zinc-900 mt-0.5 tabular-nums">
          ---
        </div>
      </div>
    </div>
  </div>

  <!-- Možnosti na výber (4 tlačidlá) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full">
    {[0, 1, 2, 3].map((idx) => (
      <button
        type="button"
        id={`detective-opt-${idx}`}
        class="detective-choice-btn group flex items-center gap-3 p-3 rounded-xl bg-white border-2 border-zinc-200/90 hover:border-zinc-300 shadow-2xs hover:shadow-sm active:scale-98 transition cursor-pointer text-left disabled:cursor-not-allowed"
        data-index={idx}
      >
        <img
          id={`detective-opt-img-${idx}`}
          src=""
          alt=""
          class="w-8 h-8 rounded-full bg-zinc-50 border border-zinc-100 p-0.5 object-contain shrink-0"
        />
        <div class="min-w-0 flex-1">
          <div id={`detective-opt-name-${idx}`} class="text-xs sm:text-sm font-bold text-zinc-900 truncate">
            ---
          </div>
          <div id={`detective-opt-symbol-${idx}`} class="text-[10px] sm:text-xs font-mono font-bold text-zinc-400 uppercase">
            ---
          </div>
        </div>
        <span class="text-zinc-300 group-hover:text-zinc-500 font-bold text-sm">→</span>
      </button>
    ))}
  </div>
</div>
