RewriteCond %{HTTP_HOST} ^kryptotipy.sk
RewriteRule (.*) https://www.kryptotipy.sk [R=301,L]

RewriteRule https://www.kryptotipy.sk/novinky?lang=SK https://www.kryptotipy.sk/posts-by-i18n/SK [L]
RewriteRule https://www.kryptotipy.sk/novinky?lang=CZ https://www.kryptotipy.sk/posts-by-i18n/CZ [L]
RewriteRule https://www.kryptotipy.sk/novinky?label=altcoin&label=blockchain&label=bitcoin&label=litecoin&label=monero&label=cardano&label=cryptocurrency&label=polkadot&label=cosmos&label=vechain&label=ethereum&label=tezos&label=ecb&label=dag&label=binance&label=bittrex&label=bitfinex&label=kraken&label=coinbase&label=fork&label=ripple&label=coinmarketcap&label=neo&label=halving&label=nbs&label=algorand&label=ontology&label=exodus&label=dash&label=ico&label=exchange&label=wallets&label=fed&label=not-categorized&lang=SK&lang=CZ https://www.kryptotipy.sk/posts/all [L]
RewriteRule https://www.kryptotipy.sk/novinky?label=cardano&lang=SK&lang=CZ https://www.kryptotipy.sk/posts/cardano [L]
